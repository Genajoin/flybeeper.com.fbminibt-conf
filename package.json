{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "vite-ssg build",
    "dev-local": "vite --port 3333 --open",
    "dev": "vite --port 5173 --host",
    "lint": "eslint .",
    "preview": "vite preview --port 5173 --host",
    "preview-https": "serve dist --port 5173 --host",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "@unocss/reset": "^0.58.9",
    "@vueuse/core": "^10.11.1",
    "@vueuse/head": "^2.0.0",
    "idb-keyval": "^6.3.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.isequal": "^4.5.0",
    "loglevel": "^1.9.2",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-3d-loader": "^2.2.4",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@iconify-json/carbon": "^1.2.24",
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/web-bluetooth": "^0.0.21",
    "@unocss/eslint-config": "^0.58.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "critters": "^0.0.24",
    "cross-env": "^7.0.3",
    "cypress": "^13.17.0",
    "cypress-vite": "^1.10.2",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-format": "^0.1.3",
    "https-localhost": "^4.7.1",
    "lint-staged": "^15.5.2",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-shikiji": "^0.9.19",
    "pnpm": "^8.15.9",
    "rollup": "^4.62.3",
    "shikiji": "^0.9.19",
    "simple-git-hooks": "^2.13.1",
    "taze": "^0.13.9",
    "typescript": "^5.9.3",
    "unocss": "^0.58.9",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.26.0",
    "unplugin-vue-markdown": "^0.25.2",
    "unplugin-vue-router": "^0.7.0",
    "vite": "^5.4.21",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-inspect": "^0.8.9",
    "vite-plugin-pwa": "^0.17.5",
    "vite-plugin-vue-devtools": "1.0.0-rc.8",
    "vite-plugin-vue-layouts": "^0.10.0",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vite-ssg": "^0.23.8",
    "vite-ssg-sitemap": "^0.6.1",
    "vitest": "^1.6.1",
    "vue-tsc": "^3.3.8"
  },
  "pnpm": {
    "overrides": {
      "@intlify/shared": "9.14.5",
      "@types/markdown-it": "^14.1.2"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
