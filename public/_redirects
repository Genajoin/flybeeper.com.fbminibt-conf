# FANET Vario was published as /devices/fbfanetvario before the SKU was renamed
# to fbfv (the name the device itself reports in DIS). Keep the old address
# alive — it may have been linked or indexed. Must stay ABOVE the SPA fallback.
/devices/fbfanetvario      /devices/fbfv            301
/devices/fbfanetvario/*    /devices/fbfv/:splat     301
/update/firmware/fbfanetvario  /update/firmware/fbfv  301

# A hashed asset that is NOT on disk must fail loudly with a 404 — it must
# never fall through to the SPA rule below and come back as index.html with a
# 200. That happened on 2026-08-18: a request raced the deploy propagation,
# got index.html under an /assets/*.js URL, and the `immutable` rule in
# `_headers` pinned that HTML in Cloudflare's edge cache for a year. Every
# visitor on the affected PoP then got a dead page — the dynamic import threw
# (nosniff blocks text/html as a module), Vue never hydrated, and the
# prerendered snapshot claimed "Web Bluetooth not available".
# Must stay ABOVE the SPA fallback.
/assets/*  /404-asset.html  404

# Cloudflare Pages SPA fallback — every unmatched path serves index.html with
# a 200 so the Vue client router can resolve the route on hydration.
/*  /index.html  200
