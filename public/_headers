# Cloudflare Pages header rules.
#
# Force the correct MIME on the PWA web app manifest — some browsers reject
# the install prompt when Content-Type isn't application/manifest+json.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Long-cache Vite's hashed asset bundles — in the BROWSER. The edge gets a
# deliberately short TTL via `cdn-cache-control`, which Cloudflare honours in
# preference to `cache-control` for its own cache.
#
# Why the split: the file name carries a content hash, so a browser can hold
# it forever without risk. Cloudflare's shared cache is the dangerous one —
# whatever it stores, it serves to everybody on that PoP. If a bad response
# ever lands under an asset URL again (a 404 during deploy propagation, an
# origin hiccup), a 10-minute edge TTL makes it a blip instead of the 20-hour
# outage of 2026-08-18. Cost is a few more origin hits; Pages is free.
/assets/*
  cache-control: public, max-age=31536000, immutable
  cdn-cache-control: public, max-age=600
